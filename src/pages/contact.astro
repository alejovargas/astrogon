---
import BaseLayout from "@components/base/BaseLayout.astro"
import ContactForm from "@components/ContactForm"
import TurnstileWidget from '@components/TurnstileWidget.astro';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with Tagragg Productions through our contact form"
>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="text-center glass rounded-lg p-8 md:col-10 lg:col-7 intersect:animate-fadeUp opacity-0 intersect-no-queue">
          <h1>Get in Touch</h1>
          <p>
            Have questions or feedback? Use the form below to reach out to us.
          </p>
          <ContactForm client:load />
          <TurnstileWidget />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
