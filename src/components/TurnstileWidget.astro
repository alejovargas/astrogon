---
// Get the site key from environment variables
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY || '0x4AAAAAABaLZZaiNLUM39vK';
---

<div id="cf-turnstile-container"></div>
<input type="hidden" id="cf-turnstile-response" name="cf-turnstile-response" value="">

<script define:vars={{ turnstileSiteKey }}>
  // Wait for the document to be fully loaded
  document.addEventListener('DOMContentLoaded', function() {
    // Load the Turnstile script
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onloadTurnstileCallback';
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
    
    // Define the callback function
    window.onloadTurnstileCallback = function() {
      renderTurnstile();
    };
  });

  function renderTurnstile() {
    try {
      // Make sure turnstile is available
      if (window.turnstile) {
        window.turnstile.render('#cf-turnstile-container', {
          // Use the site key from environment variables
          sitekey: turnstileSiteKey,
          action: 'contact_form',
          theme: 'light',
          size: 'normal',
          callback: function(token) {
            document.getElementById('cf-turnstile-response').value = token;
            console.log("Turnstile verification successful");
            
            // Dispatch an event that the React component can listen for
            const event = new CustomEvent('turnstileVerified', { detail: { token } });
            document.dispatchEvent(event);
          },
          'error-callback': function(error) {
            console.error("Turnstile error:", error);
          },
          'expired-callback': function() {
            // Reset the token when it expires
            document.getElementById('cf-turnstile-response').value = '';
            console.log("Turnstile token expired");
          }
        });
      } else {
        console.error("Turnstile not loaded");
      }
    } catch (error) {
      console.error("Error rendering Turnstile:", error);
    }
  }
</script>

<style>
  #cf-turnstile-container {
    margin: 1rem auto;
    display: flex;
    justify-content: center;
  }
</style>