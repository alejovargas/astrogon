---
import BaseLayout from "@components/base/BaseLayout.astro"
import { markdownify } from "@lib/textConverter"
import Button from "@components/common/Button.astro"
import type { HomeEntry } from "@/types"
import { Image } from "astro:assets"

interface Props {
  entry: HomeEntry
}

const { entry } = Astro.props
const {
  image,
  imageAlt,
  title,
  subtitle,
  content,
  button,
  image2,
  imageAlt2,
  title2,
  subtitle2,
  content2,
  button2,
} = entry.data
---

<BaseLayout>
  <!-- Banner -->
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="text-center lg:col-6">
          {
            image && (
              <div class="blur-[0px]">
                <Image
                  class="mb-6 w-70 md:w-full theme-aware"
                  src={image}
                  alt={imageAlt}
                  width={1024}
                  height={1024}
                  loading="eager"
                />
              </div>
            )
          }
          <h1 set:html={markdownify(title)} class="mb-0" />
          <h3 set:html={markdownify(subtitle)} class="mb-8" />
          <h5 set:html={markdownify(content)} class="text-xl my-4" />
          <h5>Thursday, July 3rd and running weekly:</h5>
          <h5>5–7 PM: Improv Class ($10 suggested donation)</h5>
          <h5 class="mb-8">7–8 PM: Optional (and FREE!) Acting Workshop</h5>
          {
            button && (
              <Button
                label={button.label}
                link={button.link}
                newtab
                hoverInvert
                color=""
              />
            )
          }
        </div>
      </div>
      <!-- <div class="row justify-center mt-40">
        <div class="text-center lg:col-6">
          {
            image2 && (
              <div class="blur-[0px]">
                <Image
                  class="mb-6 w-48 theme-aware"
                  src={image2}
                  alt={imageAlt2}
                  width={1024}
                  height={1024}
                  loading="eager"
                />
              </div>
            )
          }
          <h4 set:html={markdownify(title2)} class="mb-0" />
          <h5 set:html={markdownify(subtitle2)} class="mb-8" />
          <h5 set:html={markdownify(content2)} class="tsext-2xl mb-8" />
          {
            button2 && (
              <Button
                label={button2.label}
                link={button2.link}
                newtab
                hoverInvert
                color=""
              />
            )
          }
        </div>
      </div> -->
    </div>
  </section>
</BaseLayout>
