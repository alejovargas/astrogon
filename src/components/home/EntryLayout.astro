---
import BaseLayout from "@components/base/BaseLayout.astro"
import { markdownify } from "@lib/textConverter"
import Button from "@components/common/Button.astro"
import type { HomeEntry } from "@/types"
import { Image } from "astro:assets"
import pict from "@assets/improv-art.webp"

const picture = pict
const pictureAlt = "Improv Art"
interface Props {
  entry: HomeEntry
}

const { entry } = Astro.props
const {
  image,
  imageAlt,
  title,
  subtitle,
  content,
  button,
  image2,
  imageAlt2,
  title2,
  subtitle2,
  content2,
  button2,
} = entry.data
---

<BaseLayout>
  <!-- Banner -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="row justify-center">
        <section class="text-center lg:col-6">
          {
            image && (
              <div class="blur-[0px]">
                <Image
                  class="mb-6 w-70 md:w-full theme-aware"
                  src={image}
                  alt={imageAlt}
                  width={1024}
                  height={1024}
                  loading="eager"
                />
              </div>
            )
          }
          <!-- <h2 set:html={markdownify(title)} class="mb-0" /> -->
          <img
            src="/Beyond_a_Chritsmas_Carol.webp"
            alt="Beyond a Chritsmas Carol"
          />
          <!-- <h3 set:html={markdownify(subtitle)} class="mb-8" /> -->
          <h5 set:html={markdownify(content)} class="text-lg mb-4" />
          <section class="content mb-4 glass px-2 rounded-lg">
            <p class="font-normal">
              Three performances on December 13th <br />10am - 12 noon - 2pm
            </p>
            <p class="font-normal mb-8">
              The 45 minute immersive, travelling show begins on South Madison
              Street in front of Middleburg Books
            </p>
            <p>
              Let us know you are coming by pre-registering at <a
                href="https://www.eventbrite.com/e/1975881846793?aff=oddtdtcreator"
                style="color:yellow">Eventbrite</a
              >. <br /><strong>Free to the public</strong><br />
              <i>(donations appreciated)</i>
            </p>
          </section>
          {
            button && (
              <Button
                label={button.label}
                link={button.link}
                newtab
                hoverInvert
                color=""
              />
            )
          }
          <h6 class="mt-8 text-left">Beyond a Christmas Carol sponsored by:</h6>
          <div class="flex flex-wrap gap-2">
            <img
              src="/sponsors/Middleburg-Books.svg"
              alt="Middleburg Books"
              class="max-w-[260px]"
            />
            <img
              src="/sponsors/4-Lucky-Ducks.svg"
              alt="4 Lucky Ducks"
              class="max-w-[260px]"
            />
            <img
              src="/sponsors/Middleburg-Virginia.svg"
              alt="Middleburg Virginia"
              class="max-w-[260px]"
            />
          </div>
          <section class="content mb-4 glass px-2 rounded-lg">
            <h5 class="mt-8">
              Would you like to support Beyond a Christmas Carol, or a future
              Tagragg production?
            </h5>
            <p class="mt-2 text-left">There are multiple ways to donate:</p>
            <div class="flex flex-wrap justify-around gap-4">
              <img
                src="/paypal.webp"
                alt="PayPal QR Code"
                class="max-w-[200px] m-0"
              />
              <img
                src="/venmo.webp"
                alt="Venmo QR Code"
                class="max-w-[200px] m-0"
              />
            </div>
            <p>
              <ul>
                <li class="my-2 text-left">
                  Send a check payable to "Tagragg Productions". Please mail
                  your check to: 3277 Halfway Road, The Plains VA 20198.
                </li>
                <li class="my-2 text-left">
                  QR Code Payment: Scan the Paypal or Venmo QR codes above to
                  make a secure payment via your mobile device
                </li>
              </ul>
            </p>
            <p class="text-xs">
              Tagragg Productions is a 501c3 nonprofit corporation and all
              donations are tax deductible. Please include your contact
              information to receive tax deduction correspondence.
            </p>
          </section>
          <!-- <div class="max-w-[360px] mx-auto p-4">
            <Image
              class="rounded-md shadow-md shadow-black/50"
              src={picture}
              alt={pictureAlt}
              loading="eager"
            />
          </div> -->
        </section>
      </div>
      <!-- <div class="row justify-center mt-40">
        <div class="text-center lg:col-6">
          {
            image2 && (
              <div class="blur-[0px]">
                <Image
                  class="mb-6 w-48 theme-aware"
                  src={image2}
                  alt={imageAlt2}
                  width={1024}
                  height={1024}
                  loading="eager"
                />
              </div>
            )
          }
          <h4 set:html={markdownify(title2)} class="mb-0" />
          <h5 set:html={markdownify(subtitle2)} class="mb-8" />
          <h5 set:html={markdownify(content2)} class="tsext-2xl mb-8" />
          {
            button2 && (
              <Button
                label={button2.label}
                link={button2.link}
                newtab
                hoverInvert
                color=""
              />
            )
          }
        </div>
      </div> -->
    </div>
  </section>
</BaseLayout>
